{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "hspice",
  "rules": {
    "source_file": {
      "type": "SEQ",
      "members": [
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "_statement"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "_newline"
                  }
                ]
              },
              {
                "type": "SYMBOL",
                "name": "_newline"
              }
            ]
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_statement"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "_statement": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "comment"
        },
        {
          "type": "SYMBOL",
          "name": "include_command"
        },
        {
          "type": "SYMBOL",
          "name": "lib_command"
        },
        {
          "type": "SYMBOL",
          "name": "param_command"
        },
        {
          "type": "SYMBOL",
          "name": "model_command"
        },
        {
          "type": "SYMBOL",
          "name": "subckt_command"
        },
        {
          "type": "SYMBOL",
          "name": "ends_command"
        },
        {
          "type": "SYMBOL",
          "name": "endl_command"
        },
        {
          "type": "SYMBOL",
          "name": "end_command"
        },
        {
          "type": "SYMBOL",
          "name": "global_command"
        },
        {
          "type": "SYMBOL",
          "name": "option_command"
        },
        {
          "type": "SYMBOL",
          "name": "if_command"
        },
        {
          "type": "SYMBOL",
          "name": "elseif_command"
        },
        {
          "type": "SYMBOL",
          "name": "else_command"
        },
        {
          "type": "SYMBOL",
          "name": "endif_command"
        },
        {
          "type": "SYMBOL",
          "name": "title_command"
        },
        {
          "type": "SYMBOL",
          "name": "alter_command"
        },
        {
          "type": "SYMBOL",
          "name": "hdl_command"
        },
        {
          "type": "SYMBOL",
          "name": "generic_command"
        },
        {
          "type": "SYMBOL",
          "name": "element"
        }
      ]
    },
    "_newline": {
      "type": "PATTERN",
      "value": "\\r?\\n"
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "*"
          },
          {
            "type": "PATTERN",
            "value": "[^\\r\\n]*"
          }
        ]
      }
    },
    "inline_comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "$"
          },
          {
            "type": "PATTERN",
            "value": "[^\\r\\n]*"
          }
        ]
      }
    },
    "line_continuation": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "PATTERN",
            "value": "\\r?\\n"
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "PATTERN",
              "value": "[ \\t]*[*$][^\\r\\n]*\\r?\\n"
            }
          },
          {
            "type": "PATTERN",
            "value": "[ \\t]*\\+"
          }
        ]
      }
    },
    "backslash_continuation": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "PATTERN",
            "value": "\\\\\\\\?"
          },
          {
            "type": "PATTERN",
            "value": "\\r?\\n"
          }
        ]
      }
    },
    "raw_text": {
      "type": "PATTERN",
      "value": "[^\\r\\n]+"
    },
    "include_command": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "PATTERN",
              "value": "\\.(include|incl|inc)",
              "flags": "i"
            },
            "named": true,
            "value": "command_name"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "path",
