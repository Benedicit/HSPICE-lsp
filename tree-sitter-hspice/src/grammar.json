              {
                "type": "STRING",
                "value": "("
              },
              {
                "type": "SYMBOL",
                "name": "_list_item"
              },
              {
                "type": "REPEAT1",
                "content": {
                  "type": "SYMBOL",
                  "name": "_list_item"
                }
              },
              {
                "type": "STRING",
                "value": ")"
              }
            ]
